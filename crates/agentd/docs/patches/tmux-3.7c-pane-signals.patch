+/* Callback for cursor_attrs: attributes of the cell under the cursor. */
+static void *
+format_cb_cursor_attrs(struct format_tree *ft)
+{
+	struct window_pane	*wp = ft->wp;
+	struct grid_cell	 gc;
+
+	if (wp == NULL)
+		return (NULL);
+
+	grid_view_get_cell(wp->base.grid, wp->base.cx, wp->base.cy, &gc);
+	return (xstrdup(attributes_tostring(gc.attr)));
+}
+
+/* Callback for pane_last_output. */
+static void *
+format_cb_pane_last_output(struct format_tree *ft)
+{
+	if (ft->wp != NULL)
+		return (&ft->wp->last_output_time);
+	return (NULL);
+}
